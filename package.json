{
	"name": "the-peoples-plant-67",
	"version": "0.1.0",
	"description": "Your AI agent org, drawn as a Soviet factory in pixel art.",
	"license": "MIT",
	"author": "The Chief Engineer",
	"repository": {
		"type": "git",
		"url": "https://github.com/People-sPlant-67/the-peoples-plant-67.git"
	},
	"homepage": "https://people-splant-67.github.io/the-peoples-plant-67/",
	"private": true,
	"type": "module",
	"bin": {
		"the-peoples-plant-67": "dist-bridge/cli.mjs"
	},
	"files": [
		"dist-bridge",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && npm run bridge && npm run demo && npm run ext",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"snap": "tsx scripts/snap.ts",
		"reel": "tsx scripts/reel.ts",
		"test": "tsx --test tests/*.test.ts",
		"ext": "tsx scripts/build-extension.ts",
		"demo": "vite build -c vite.demo.config.ts && node -e \"require('fs').renameSync('dist-demo/cockpit.html', 'dist-demo/index.html')\"",
		"onboarding": "tsx scripts/onboarding-doc.ts",
		"leak-scan": "node scripts/leak-scan.mjs && node scripts/leak-scan.mjs --history",
		"prepare": "git config core.hooksPath .githooks || true; tsx scripts/build-bridge.ts",
		"bridge": "tsx scripts/build-bridge.ts",
		"landing": "npm run demo && vite build -c vite.landing.config.ts && node scripts/build-landing.mjs"
	},
	"devDependencies": {
		"@types/node": "24.13.6",
		"happy-dom": "20.14.5",
		"pixi.js": "8.21.0",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	}
}
